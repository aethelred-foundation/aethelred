# Generated multi-workload drill evidence (regenerated by `make m42-sandbox-drill-all`
# and validated by the gap audit in CI). The canonical active-workload evidence
# under config/pilots/m42/evidence/exports stays tracked.
config/pilots/m42/evidence/workloads/
# Generated synthetic fixtures (~35MB, 100,000 cases). Deterministic and
# regenerated by `make m42-workloads-generate`; the generator in
# scripts/m42_workloads.py is the committed source of truth. Packs, catalog,
# and evaluation protocols stay tracked.
docs/workload-packs/m42/workloads/*/synthetic.jsonl

