# Copy to config/pilots/m42/sandbox.env for local/private M42 sandbox overrides.

M42_SANDBOX_PROJECT=aethelred-m42-pilot
M42_CHAIN_ID=aethelred-m42-pilot-1
M42_MONIKER=m42-exclusive-validator

M42_VALIDATOR_RPC=localhost:36657
M42_VALIDATOR_GRPC=localhost:39090
M42_TEE_ENDPOINT=localhost:18545
M42_ATTESTATION_ENDPOINT=localhost:18545
M42_ZKML_PROVER=localhost:18546
M42_BRIDGE_ENDPOINT=localhost:0
M42_ARCHIVE_DEST=localhost:19200

# The evidence archive runs with the OpenSearch security plugin enabled.
# scripts/m42-sandbox.sh exports M42_ARCHIVE_ADMIN_PASSWORD from
# config/pilots/m42/secrets/opensearch_admin_password.txt (generated by
# `scripts/m42-sandbox.sh prepare`). Override the scheme only when fronting
# the archive with an external TLS-terminating proxy.
M42_ARCHIVE_SCHEME=https
M42_ARCHIVE_USER=admin

# Image digest pinning: run `scripts/m42-sandbox.sh pin-images` to write
# config/pilots/m42/images.lock.env. The lock file is sourced automatically;
# set M42_*_IMAGE here only to deliberately override a pinned reference.
M42_PROMETHEUS_ENDPOINT=localhost:19090
M42_ALERTMANAGER_ENDPOINT=localhost:19093
M42_GRAFANA_ENDPOINT=localhost:13001

# Pre-testnet package validation may run before services are up.
# Live sandbox validation requires these endpoints to be reachable.
M42_SANDBOX_MODE=pretestnet

# Keep false unless the signed pilot plan explicitly allows simulated local evidence.
AETHELRED_ALLOW_SIMULATED=false
TEE_MODE=production
PROVER_MODE=production

# Required for live paid-pilot validation when AETHELRED_ALLOW_SIMULATED=false.
# Leave empty only for package preflight or before the real backend is provisioned.
AETHELRED_TEE_BACKEND_URL=
AETHELRED_ZKML_BACKEND_URL=
