{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aethelred.network/schemas/aethelred-anchor-manifest-v0.2.schema.json",
  "title": "Aethelred Anchor Manifest v0.2",
  "type": "object",
  "required": [
    "schema_version",
    "anchor_id",
    "generated_at",
    "run_id",
    "seal_id",
    "mode",
    "status",
    "target_networks",
    "commitments",
    "chain_payload",
    "signer",
    "anchor_hash",
    "signature"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "aethelred-anchor-manifest-v0.2" },
    "anchor_id": { "type": "string", "pattern": "^anchor_[0-9a-f]{24}$" },
    "generated_at": { "type": "string" },
    "run_id": { "type": "string" },
    "seal_id": { "type": "string" },
    "mode": { "type": "string" },
    "status": { "type": "string" },
    "target_networks": {
      "type": "array",
      "minItems": 1
    },
    "commitments": {
      "type": "object",
      "required": [
        "seal_hash",
        "seal_id",
        "policy_receipt_hash",
        "evidence_bundle_hash",
        "validator_quorum_hash"
      ]
    },
    "chain_payload": {
      "type": "object",
      "required": ["type_url", "body"]
    },
    "signer": { "type": "object" },
    "anchor_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "signature": { "type": "string", "minLength": 4 }
  }
}
