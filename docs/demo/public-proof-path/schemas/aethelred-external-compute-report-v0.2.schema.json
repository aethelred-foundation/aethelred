{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aethelred.network/schemas/aethelred-external-compute-report-v0.2.schema.json",
  "title": "Aethelred External Compute Report v0.2",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "provider",
    "provider_profile",
    "workload_id",
    "execution_region",
    "attestation_type",
    "external_proof_hash",
    "accepted",
    "checks",
    "failed_required_checks",
    "normalized_claims",
    "strategic_interop_note",
    "signer",
    "report_hash",
    "signature"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "aethelred-external-compute-report-v0.2" },
    "generated_at": { "type": "string" },
    "provider": { "type": "string" },
    "provider_profile": { "type": ["object", "null"] },
    "workload_id": { "type": "string" },
    "execution_region": { "type": "string" },
    "attestation_type": { "type": "string" },
    "external_proof_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "accepted": { "type": "boolean" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "required", "passed", "evidence"],
        "additionalProperties": true
      }
    },
    "failed_required_checks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "normalized_claims": { "type": "object" },
    "strategic_interop_note": { "type": "string" },
    "signer": { "type": "object" },
    "report_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "signature": { "type": "string", "minLength": 4 }
  }
}
