{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aethelred.network/schemas/aethelred-pilot-readiness-gate-v0.2.schema.json",
  "title": "Aethelred Pilot Readiness Gate v0.2",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "use_case",
    "tenant",
    "public_proof_ready",
    "regulated_pilot_status",
    "production_status",
    "gates",
    "open_production_blockers",
    "signer",
    "gate_hash",
    "signature"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "aethelred-pilot-readiness-gate-v0.2" },
    "generated_at": { "type": "string" },
    "use_case": { "type": "string" },
    "tenant": { "type": "string" },
    "public_proof_ready": { "type": "boolean" },
    "regulated_pilot_status": { "enum": ["conditional-pass", "blocked"] },
    "production_status": { "enum": ["production-ready", "not-production-ready"] },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "status", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "status": { "enum": ["pass", "warning", "fail"] },
          "evidence": {}
        },
        "additionalProperties": true
      }
    },
    "open_production_blockers": { "type": "array" },
    "signer": { "type": "object" },
    "gate_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "signature": { "type": "string", "minLength": 4 }
  }
}
