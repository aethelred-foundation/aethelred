{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aethelred.network/schemas/aethelred-procurement-readiness-pack-v0.2.schema.json",
  "title": "Aethelred Procurement Readiness Pack v0.2",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "tenant",
    "use_case",
    "buyer_status",
    "controls",
    "required_buyer_documents",
    "commercial_packaging",
    "open_conditions",
    "signer",
    "pack_hash",
    "signature"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "aethelred-procurement-readiness-pack-v0.2" },
    "generated_at": { "type": "string" },
    "tenant": { "type": "object" },
    "use_case": { "type": "string" },
    "buyer_status": { "enum": ["pilot-procurement-ready-with-conditions", "blocked"] },
    "controls": { "type": "array", "minItems": 1 },
    "required_buyer_documents": { "type": "array", "minItems": 1 },
    "commercial_packaging": { "type": "object" },
    "open_conditions": { "type": "array" },
    "signer": { "type": "object" },
    "pack_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "signature": { "type": "string", "minLength": 4 }
  }
}
