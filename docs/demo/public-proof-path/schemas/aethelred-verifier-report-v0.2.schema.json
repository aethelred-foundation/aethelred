{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aethelred.network/schemas/aethelred-verifier-report-v0.2.schema.json",
  "title": "Aethelred Verifier Report v0.2",
  "type": "object",
  "required": [
    "schema_version",
    "checked_at",
    "valid",
    "seal_id",
    "run_id",
    "checks",
    "readiness",
    "next_production_steps"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": "aethelred-verifier-report-v0.2" },
    "checked_at": { "type": "string" },
    "valid": { "type": "boolean" },
    "seal_id": { "type": "string" },
    "run_id": { "type": "string" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "status", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "status": { "enum": ["pass", "warning", "fail"] },
          "evidence": {}
        },
        "additionalProperties": true
      }
    },
    "readiness": {
      "type": "object",
      "required": ["public_proof_path", "regulated_pilot", "production_grade", "warning_count"]
    },
    "next_production_steps": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
