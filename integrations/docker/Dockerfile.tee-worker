FROM golang:1.25.12-alpine@sha256:56961d79ea8129efddcc0b8643fd8a5416b4e6228cfd477e3fd61deb2672c587 AS builder

ARG TARGETOS=linux
ARG TARGETARCH=amd64

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS="${TARGETOS}" GOARCH="${TARGETARCH}" go build -tags production,pqc_circl -o /out/aethelred-tee-worker ./cmd/aethelred-tee-worker

FROM alpine:3.24.1@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

RUN apk add --no-cache ca-certificates

COPY --from=builder /out/aethelred-tee-worker /usr/local/bin/aethelred-tee-worker

EXPOSE 8545

ENTRYPOINT ["/usr/local/bin/aethelred-tee-worker"]
